BACKEND_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 48 (vacío solo en desarrollo: se usa uno aleatorio por proceso)
SESSION_SECRET=
SESSION_COOKIE_NAME=canchaya.session
NEXT_PUBLIC_APP_NAME=CanchaYa
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Rate limit por IP real. Cabecera que pone tu proxy de confianza (p. ej. x-real-ip)
# y el mismo secreto que BFF_SHARED_SECRET del backend (openssl rand -base64 48).
# Ambas son OBLIGATORIAS en producción: sin ellas el backend ve la IP del BFF en todos los
# intentos de login y un solo atacante bloquearía el acceso de todos.
CLIENT_IP_HEADER=
BFF_SHARED_SECRET=

# App móvil (opcional): universal links / App Links para /restablecer.
# App ID de iOS: TEAMID.bundleId, separados por coma (p. ej. ABCDE12345.com.canchaya.app).
MOBILE_IOS_APP_IDS=
# Paquete Android y huellas SHA-256 del certificado de firma (EAS o Play App Signing), por coma.
MOBILE_ANDROID_PACKAGE=com.canchaya.app
MOBILE_ANDROID_CERT_SHA256=
